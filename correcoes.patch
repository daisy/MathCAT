@@ -0,0 +1,704 @@
+---
+# unicode-full.yaml — português (pt-BR)
+#
+# Traduzido a partir do INGLÊS (nunca do espanhol: ver AUDITORIA.md).
+# Cobertura: as quatro faixas que o guia oficial de tradutores recomenda
+# priorizar — acentos 0x2D8-0x2DD, setas 0x2190-0x21FF, operadores
+# matemáticos 0x2200-0x22FF e formas geométricas 0x25A0-0x25FF.
+#
+# Caracteres já definidos em unicode.yaml foram deliberadamente OMITIDOS:
+# o motor avisa quando um caractere aparece nas duas tabelas.
+# Caracteres fora destas faixas caem no inglês, que é o comportamento de
+# degradação seguro do MathCAT (melhor inglês do que soletrar o codepoint).
+#
+# Todas as entradas usam T:/OT: maiúsculo porque foram conferidas uma a uma.
+# As setas seguem um padrão composicional deliberado, com a direção antes do
+# sintagma preposicional, como pede a sintaxe portuguesa:
+#     "seta para a esquerda com cauda"      (não "seta com cauda esquerda")
+#     "seta tracejada para a esquerda"      (adjetivo cola no substantivo)
+
+ - "˘": [T: "breve"]                          # 0x2d8
+ - "˚": [T: "anel acima"]                     # 0x2da
+ - "˛": [T: "ogonek"]                         # 0x2db
+ - "˜": [T: "til pequeno"]                    # 0x2dc
+ - "˝": [T: "acento agudo duplo"]             # 0x2dd
+ - "↔": [T: "seta para a esquerda e para a direita"] # 0x2194
+ - "↕": [T: "seta para cima e para baixo"]    # 0x2195
+ - "↖": [T: "seta para noroeste"]             # 0x2196
+ - "↙": [T: "seta para sudoeste"]             # 0x2199
+ - "↚": [T: "seta para a esquerda com traço"] # 0x219a
+ - "↛": [T: "seta para a direita com traço"]  # 0x219b
+ - "↜": [T: "seta ondulada para a esquerda"]  # 0x219c
+ - "↝": [T: "seta ondulada para a direita"]   # 0x219d
+ - "↞": [T: "seta de duas pontas para a esquerda"] # 0x219e
+ - "↟": [T: "seta de duas pontas para cima"]  # 0x219f
+ - "↠": [T: "seta de duas pontas para a direita"] # 0x21a0
+ - "↡": [T: "seta de duas pontas para baixo"] # 0x21a1
+ - "↢": [T: "seta para a esquerda com cauda"] # 0x21a2
+ - "↣": [T: "seta para a direita com cauda"]  # 0x21a3
+ - "↤": [T: "seta para a esquerda a partir de barra"] # 0x21a4
+ - "↥": [T: "seta para cima a partir de barra"] # 0x21a5
+ - "↦": [T: "seta para a direita a partir de barra"] # 0x21a6
+ - "↧": [T: "seta para baixo a partir de barra"] # 0x21a7
+ - "↨": [T: "seta para cima e para baixo com base"] # 0x21a8
+ - "↩": [T: "seta para a esquerda com gancho"] # 0x21a9
+ - "↪": [T: "seta para a direita com gancho"] # 0x21aa
+ - "↫": [T: "seta para a esquerda com laço"]  # 0x21ab
+ - "↬": [T: "seta para a direita com laço"]   # 0x21ac
+ - "↭": [T: "seta ondulada para a esquerda e para a direita"] # 0x21ad
