+ - "⇁": [T: "arpão para a direita com farpa para baixo"] # 0x21c1
+ - "⇂": [T: "arpão para baixo com farpa para a direita"] # 0x21c2
+ - "⇃": [T: "arpão para baixo com farpa para a esquerda"] # 0x21c3
+ - "⇄": [T: "seta para a direita sobre seta para a esquerda"] # 0x21c4
+ - "⇅": [T: "seta para cima à esquerda de seta para baixo"] # 0x21c5
+ - "⇆": [T: "seta para a esquerda sobre seta para a direita"] # 0x21c6
+ - "⇇": [T: "duas setas para a esquerda"]     # 0x21c7
+ - "⇈": [T: "duas setas para cima"]           # 0x21c8
+ - "⇉": [T: "duas setas para a direita"]      # 0x21c9
+ - "⇊": [T: "duas setas para baixo"]          # 0x21ca
+ - "⇋": [T: "arpão para a esquerda sobre arpão para a direita"] # 0x21cb
+ - "⇌": [T: "arpão para a direita sobre arpão para a esquerda"] # 0x21cc
+ - "⇍": [T: "seta dupla para a esquerda com traço"] # 0x21cd
+ - "⇎": [T: "seta dupla para a esquerda e para a direita com traço"] # 0x21ce
+ - "⇏": [T: "seta dupla para a direita com traço"] # 0x21cf
+ - "⇐": [T: "seta dupla para a esquerda"]     # 0x21d0
+ - "⇑": [T: "seta dupla para cima"]           # 0x21d1
+ - "⇓": [T: "seta dupla para baixo"]          # 0x21d3
+ - "⇔": [T: "se e somente se"]                # 0x21d4
+ - "⇕": [T: "seta dupla para cima e para baixo"] # 0x21d5
+ - "⇖": [T: "seta dupla para noroeste"]       # 0x21d6
+ - "⇗": [T: "seta dupla para nordeste"]       # 0x21d7
+ - "⇘": [T: "seta dupla para sudeste"]        # 0x21d8
+ - "⇙": [T: "seta dupla para sudoeste"]       # 0x21d9
+ - "⇚": [T: "seta tripla para a esquerda"]    # 0x21da
+ - "⇛": [T: "seta tripla para a direita"]     # 0x21db
+ - "⇜": [T: "seta serpenteante para a esquerda"] # 0x21dc
+ - "⇝": [T: "seta serpenteante para a direita"] # 0x21dd
+ - "⇞": [T: "seta para cima com traço duplo"] # 0x21de
+ - "⇟": [T: "seta para baixo com traço duplo"] # 0x21df
+ - "⇠": [T: "seta tracejada para a esquerda"] # 0x21e0
+ - "⇡": [T: "seta tracejada para cima"]       # 0x21e1
+ - "⇢": [T: "seta tracejada para a direita"]  # 0x21e2
