+ - "↯": [T: "seta em zigue-zague para baixo"] # 0x21af
+ - "↰": [T: "seta para cima com ponta para a esquerda"] # 0x21b0
+ - "↱": [T: "seta para cima com ponta para a direita"] # 0x21b1
+ - "↲": [T: "seta para baixo com ponta para a esquerda"] # 0x21b2
+ - "↳": [T: "seta para baixo com ponta para a direita"] # 0x21b3
+ - "↴": [T: "seta para a direita com canto para baixo"] # 0x21b4
+ - "↵": [T: "seta para baixo com canto para a esquerda"] # 0x21b5
+ - "↶": [T: "seta semicircular superior no sentido anti-horário"] # 0x21b6
+ - "↷": [T: "seta semicircular superior no sentido horário"] # 0x21b7
+ - "↸": [T: "seta para noroeste até barra longa"] # 0x21b8
+ - "↹": [T: "seta para a esquerda até barra sobre seta para a direita até barra"] # 0x21b9
+ - "↺": [T: "seta circular aberta no sentido anti-horário"] # 0x21ba
+ - "↻": [T: "seta circular aberta no sentido horário"] # 0x21bb
+ - "↼": [T: "arpão para a esquerda com farpa para cima"] # 0x21bc
+ - "↽": [T: "arpão para a esquerda com farpa para baixo"] # 0x21bd
+ - "↾": [T: "arpão para cima com farpa para a direita"] # 0x21be
+ - "↿": [T: "arpão para cima com farpa para a esquerda"] # 0x21bf
